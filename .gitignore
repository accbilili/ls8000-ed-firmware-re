# ---------------------------------------------------------------------------
# LS-8000 ED 固件逆向仓库 —— 忽略规则
# 核心原则：**任何二进制、任何样本、任何转储，都不允许进入版本库**
# Core principle: NO binaries, NO samples, NO dumps may ever enter this repo.
# ---------------------------------------------------------------------------

# ========== 二进制固件 / Binary firmware ==========
*.bin
*.rom
*.hex
*.mot
*.s19
*.img
*.fw
*.EFI

# ========== 驱动与可执行文件 / Drivers & executables ==========
*.sys
*.dll
*.exe
*.msi
*.cab

# ========== 内存转储 / Memory dumps ==========
*.dmp
*.mdmp
**/dumps/**
dumps/

# ========== 样本 / Samples（需自备，见 samples_manifest.txt） ==========
samples/
sample/
*.raw
*.tif
*.tiff

# ========== Python ==========
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
.venv/
venv/
env/
build/
dist/
*.egg-info/

# ========== 本地分析与输出 / Local analysis output ==========
_out/
out/
tmp/
temp/
*.log
*.bak
*.orig
*.rej

# ========== 环境与密钥 / Env & secrets ==========
.env
.env.*
!.env.example
*.pem
*.key
id_rsa*
*.pfx

# ========== 操作系统 / OS ==========
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
desktop.ini

# ========== 编辑器 / Editors ==========
.vscode/
.idea/
*.swp
*.swo
*~
